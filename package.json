{
  "name": "l1-git",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "bridge": "cargo run -p l1-git-dev-bridge",
    "fixture": "node scripts/create-fixture.mjs",
    "fixture:large": "node scripts/create-large-fixture.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 src",
    "build": "pnpm typecheck && vite build",
    "test": "pnpm test:release && cargo build -p l1-git-dev-bridge && vitest run src",
    "test:core": "cargo test -p l1-git-core",
    "tauri": "tauri",
    "icon:macos": "node scripts/generate-macos-icon.mjs",
    "format": "prettier --write src scripts package.json tsconfig.json vite.config.ts eslint.config.js src-tauri/*.json src-tauri/capabilities/*.json",
    "format:check": "prettier --check src scripts package.json tsconfig.json vite.config.ts eslint.config.js src-tauri/*.json src-tauri/capabilities/*.json",
    "test:release": "node --test scripts/release-plan.test.mjs scripts/release-assets.test.mjs scripts/updater-manifest.test.mjs",
    "fixture:merge": "node scripts/create-merge-fixture.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@pierre/diffs": "1.5.2",
    "@pierre/trees": "1.0.0-beta.6",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "fflate": "^0.8.3",
    "jsonc-parser": "^3.3.1",
    "lucide-react": "^0.577.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.2",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "happy-dom": "^21.0.4",
    "prettier": "3.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.4",
    "vitest": "^5.0.3"
  }
}
